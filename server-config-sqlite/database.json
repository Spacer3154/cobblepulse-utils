{
  // Choix : "SQLITE" (par defaut, zero config) ou "MYSQL"
  "storage_type": "SQLITE",
  "mysql": {
    "host": "localhost",
    "port": 3306,
    "database": "cobblepulse_utils",
    "username": "root",
    "password": "password",
    "pool_size": 10,
    "use_ssl": false
  },
  // Fichier SQLite (relatif a config/cobblepulse/utils/)
